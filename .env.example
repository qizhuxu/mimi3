# mimi3-n 环境变量 —— 敏感 / 易变值
# 复制为 .env（已 gitignored），填真实值。
# uv run --env-file .env python src/run_manager.py plan  自动加载

# ── Cloudflare Tunnel ──────────────────────────────────
# 所有 claw replica 共用此 tunnel。从 Cloudflare Dashboard → Tunnels → 你的 tunnel 获取。
# deploy-user.sh 会用 --token $TUNNEL_TOKEN 远程管理，不需写本地 config.yml。
TUNNEL_TOKEN=

# ── 客户端鉴权 ─────────────────────────────────────────
# 用户调 https://mimo.7786.pp.ua/v1/... 时需带 Authorization: Bearer <这个值>。
# Caddy 用此值校验请求，无 key / key 错一律 401。
PROXY_API_KEY=

# ── L3 健康检查（可选） ────────────────────────────────
# 提供则 health_monitor 调 Cloudflare API 按 connector_id 配对确认 replica 真上线。
# 不配则退化到云端 status+remain 探测（测不出 cloudflared 崩）。
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ── 账号管理器运行时（可选，有默认值） ──────────────
# 未配时走 config.json 或硬编码默认值。
# MIMI3N_MIN_ACCOUNTS=8
# MIMI3N_TICK_SECONDS=30