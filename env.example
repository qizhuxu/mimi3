# 复制为 .env 或在系统环境变量中设置（不要提交 .env）

# 网关绑定地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 必需配置，Claw 节点连接的 WebSocket 桥接地址
WS_TUNNEL_URL=ws://your-domain.com:8000/ws
# 可选：仅用于网关 /api/stats 节点监测请求的 HTTP/HTTPS 代理
# MIMO_GATEWAY_STATS_PROXY=http://user:pass@127.0.0.1:8080

# 运行时配置。auto 表示环境变量锁定已设置项，其余项可由 WebUI 写入 data/runtime_config.json
# MIMO_CONFIG_SOURCE=auto
# MIMO_RUNTIME_CONFIG_PATH=/app/data/runtime_config.json

# Docker 本地持久化路径
MIMO_METRICS_DB_PATH=/app/data/gateway_metrics.db
MIMO_METRICS_SNAPSHOT_PATH=/app/data/gateway_snapshot.json
MIMO_PROCESS_LOCK_PATH=/app/data/mimo2api.lock

# 日志。默认关闭 Uvicorn access log，避免 WebUI 轮询刷屏；排查 HTTP 明细时再打开。
# MIMO_LOG_LEVEL=INFO
# MIMO_ACCESS_LOG=false
# MIMO_LOG_TEXT_LIMIT=360
# MIMO_SHUTDOWN_TASK_TIMEOUT=5
# MIMO_WINDOWS_SELECTOR_LOOP=true

# 本机 OpenAI 兼容 /v1 的 Bearer 密钥（客户端 api_key）；不设则不对中转鉴权
# MIMO_RELAY_OPENAI_KEY=sk-your-random-secret-here

# WebUI 登录口令；不设则不启用 WebUI/API 管理面登录
# MIMO_WEBUI_USERNAME=admin
# MIMO_WEBUI_PASSWORD=change-me

# WebUI 会话签名密钥；不设时默认退化为使用上面的密码参与签名
# MIMO_WEBUI_SECRET=replace-with-a-long-random-string

# WebUI 会话有效期（秒），默认 43200，即 12 小时
# MIMO_WEBUI_SESSION_TTL_SECONDS=43200

# 仅在 HTTPS 反代后建议开启
# MIMO_WEBUI_COOKIE_SECURE=false

# 生命周期监测与自动重建策略
# MIMO_MANAGER_AUTOSTART=true
# MIMO_LIFECYCLE_MONITOR_INTERVAL_SECONDS=300
# MIMO_LIFECYCLE_NODE_STALE_SECONDS=90
# MIMO_LIFECYCLE_INSTANCE_MAX_LIFETIME_SECONDS=14400
# MIMO_LIFECYCLE_DAILY_CREATE_LIMIT=1
# MIMO_BRIDGE_HEARTBEAT_SECONDS=30

# 内置 Cloudflare Tunnel：none / cloudflare_quick / cloudflare_named
# MIMO_TUNNEL_MODE=none
# MIMO_CLOUDFLARED_BIN=cloudflared
# MIMO_CLOUDFLARE_TUNNEL_TOKEN=
# MIMO_CLOUDFLARE_PUBLIC_HOSTNAME=
